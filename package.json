{
  "name": "voltgrid",
  "version": "1.0.0",
  "description": "VoltGrid EV Charging Network Platform for Bengaluru",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "nodemon server/server.js",
    "start": "node server/server.js",
    "seed": "node server/scripts/seed.js",
    "reset": "node server/scripts/reset.js",
    "indexes": "node server/scripts/indexes.js",
    "db:verify": "node server/scripts/verifyDb.js",
    "simulator": "node server/scripts/simulator.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node server/scripts/seedTestDb.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js"
  },
  "keywords": [
    "ev-charging",
    "mongodb",
    "realtime",
    "bengaluru",
    "clean-energy"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^14.0.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.2",
    "supertest": "^7.0.0"
  }
}
