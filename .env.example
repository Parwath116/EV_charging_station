# VoltGrid EV Platform Environment Configuration

# Server Application Port (never use 3000)
PORT=5173

# Application Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection String (Single-node replica set for change streams & transactions)
# Docker Local: mongodb://127.0.0.1:27018/voltgrid?replicaSet=rs0&directConnection=true
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/voltgrid?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27018/voltgrid?replicaSet=rs0&directConnection=true

# Database Name
DB_NAME=voltgrid

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:5173

# Authentication Security
JWT_SECRET=voltgrid_production_super_secret_signing_key_2026_xyz
JWT_EXPIRES_IN=7d

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info
